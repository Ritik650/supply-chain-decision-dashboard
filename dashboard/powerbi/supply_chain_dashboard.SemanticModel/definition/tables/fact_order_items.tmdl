/// One row per order item (the grain). Use the measures in _Measures, not these columns.
table fact_order_items
	lineageTag: c8a88d18-6702-5ab1-ba4c-f349c8a50f8a

	column order_item_id
		dataType: int64
		isHidden
		lineageTag: b5978d63-ba6c-5048-944b-b2984a597d3f
