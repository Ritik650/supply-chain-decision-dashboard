		isHidden
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: 361cb87c-a94a-51dc-b3e9-01bfac32a961
		summarizeBy: sum
		sourceColumn: profit

		annotation SummarizationSetBy = User

