	column 'Discount Band'
		dataType: string
		lineageTag: 53e3a849-3378-5ab0-8022-06b55ab0eaf3
		summarizeBy: none
		sourceColumn: Discount Band
		sortByColumn: 'Discount Band Order'

		annotation SummarizationSetBy = User

	column 'Discount Band Order'
		dataType: int64
		isHidden
		lineageTag: bac25a12-3721-5d79-bafe-0bad082f560e
		summarizeBy: none
		sourceColumn: Discount Band Order

		annotation SummarizationSetBy = User

	partition fact_order_items = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_order_items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"order_item_id", "order_id", "order_date_key", "ship_date_key", "customer_key", "product_key", "geo_key", "shipping_key", "order_status", "delivery_status", "is_valid_order", "is_late", "quantity", "unit_price", "sales", "discount", "discount_rate", "item_total", "profit", "actual_days", "scheduled_days", "delay_days"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"order_item_id", Int64.Type}, {"order_id", Int64.Type}, {"order_date_key", Int64.Type}, {"ship_date_key", Int64.Type}, {"customer_key", Int64.Type}, {"product_key", Int64.Type}, {"geo_key", Int64.Type}, {"shipping_key", Int64.Type}, {"order_status", type text}, {"delivery_status", type text}, {"is_valid_order", type logical}, {"is_late", type logical}, {"quantity", Int64.Type}, {"unit_price", Currency.Type}, {"sales", Currency.Type}, {"discount", Currency.Type}, {"discount_rate", type number}, {"item_total", Currency.Type}, {"profit", Currency.Type}, {"actual_days", Int64.Type}, {"scheduled_days", Int64.Type}, {"delay_days", Int64.Type}}, "en-US"),
				    Added0 = Table.AddColumn(Typed, "Discount Band", each if [discount_rate] < 0.05 then "0-5%" else if [discount_rate] < 0.10 then "5-10%" else if [discount_rate] < 0.15 then "10-15%" else if [discount_rate] < 0.20 then "15-20%" else "20-25%", type text),
				    Added1 = Table.AddColumn(Added0, "Discount Band Order", each if [discount_rate] < 0.05 then 1 else if [discount_rate] < 0.10 then 2 else if [discount_rate] < 0.15 then 3 else if [discount_rate] < 0.20 then 4 else 5, Int64.Type)
				in
				    Added1

	annotation PBI_ResultType = Table
