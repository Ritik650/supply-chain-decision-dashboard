	/// gross = unit_price x quantity
	column sales
		dataType: decimal
		isHidden
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: 55a1ae85-9990-566e-bd50-8a6c6740d366
		summarizeBy: sum
		sourceColumn: sales

