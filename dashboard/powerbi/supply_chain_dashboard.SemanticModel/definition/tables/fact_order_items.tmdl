		summarizeBy: sum
		sourceColumn: quantity

		annotation SummarizationSetBy = User

	column unit_price
		dataType: decimal
		isHidden
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 51f92073-0f1a-5228-b3e2-7b35cc9900fe
		summarizeBy: sum
		sourceColumn: unit_price

