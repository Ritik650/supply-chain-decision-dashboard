	column delivery_status
		dataType: string
		lineageTag: 113d5dd0-c257-51eb-9303-caddea8d4999
		summarizeBy: none
		sourceColumn: delivery_status

		annotation SummarizationSetBy = User

	/// FALSE for CANCELED and SUSPECTED_FRAUD; every KPI uses TRUE only
	column is_valid_order
		dataType: boolean
		isHidden
		lineageTag: a771e877-ed49-5bfe-81fd-111a9b327ac9
		summarizeBy: none
		sourceColumn: is_valid_order

		annotation SummarizationSetBy = User

	/// actual_days > scheduled_days
	column is_late
		dataType: boolean
		isHidden
		lineageTag: 32b5609e-5a5d-5a0b-bd4e-33d2065b932c
		summarizeBy: none
		sourceColumn: is_late

		annotation SummarizationSetBy = User

	column quantity
