/// Cohort x month retention for the analysis window (p4_cohort_retention.sql). Not filterable.
table cohort_retention
	lineageTag: 887ec0e9-fef4-50f9-bf49-c72762489540

	column cohort_month
		dataType: dateTime
		formatString: mmm yy
		lineageTag: dc6e2394-3cda-5e8b-9448-ecbdef195b08
		summarizeBy: none
		sourceColumn: cohort_month

		annotation SummarizationSetBy = User

		annotation UnderlyingDateTimeDataType = Date

	column cohort_size
		dataType: int64
		lineageTag: a9409929-c6fc-5762-a931-85318530a810
		summarizeBy: none
		sourceColumn: cohort_size

		annotation SummarizationSetBy = User

	column month_index
		dataType: int64
		lineageTag: 6c9f27eb-a8e0-5d55-84a6-a1077b5628de
		summarizeBy: none
		sourceColumn: month_index

		annotation SummarizationSetBy = User

	column active_customers
		dataType: int64
		lineageTag: 5f6b693d-da8e-5f01-a820-232156c9e40d
		summarizeBy: sum
		sourceColumn: active_customers

		annotation SummarizationSetBy = User

	column retention
		dataType: double
		formatString: 0%;-0%;0%
		lineageTag: 9f09ccae-5e45-5793-aad6-d74bd2494994
		summarizeBy: none
		sourceColumn: retention

		annotation SummarizationSetBy = User

	partition cohort_retention = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "cohort_retention.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"cohort_month", "cohort_size", "month_index", "active_customers", "retention"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"cohort_month", type date}, {"cohort_size", Int64.Type}, {"month_index", Int64.Type}, {"active_customers", Int64.Type}, {"retention", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

