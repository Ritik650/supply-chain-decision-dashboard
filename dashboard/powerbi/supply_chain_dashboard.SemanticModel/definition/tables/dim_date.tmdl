/// Calendar, marked as the date table.
table dim_date
	lineageTag: a63d17ea-38ac-5435-8fdd-feada490cc2d
	dataCategory: Time

	column date_key
		dataType: int64
		isHidden
		lineageTag: 5406f733-df50-5892-b70f-204fad19132d
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = User

	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 96958d23-1ff7-5908-a74f-46d4e0726a3f
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = User

	column year
		dataType: int64
		formatString: 0
		lineageTag: fa892c20-cb3f-5863-807f-5a2f1faca300
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column quarter
		dataType: int64
		lineageTag: 228cbe3d-a60b-5d13-80ad-2452930eaf1e
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = User

	column month
		dataType: int64
		isHidden
		lineageTag: 1635c693-87f7-5aec-a1d3-ee716719802d
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = User

	column month_name
		dataType: string
		lineageTag: 7628d8af-b7d3-5e7d-b0fe-29527579ada7
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

		annotation SummarizationSetBy = User

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: e58ef3cd-81db-5eb5-a38a-474fb598a86a
		summarizeBy: none
		sourceColumn: month_start

		annotation SummarizationSetBy = User

	column year_month
		dataType: string
		lineageTag: 9e4b996c-9f3f-5d61-8510-26a94bc0880e
		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = User

	column weekday_num
		dataType: int64
		isHidden
		lineageTag: d6706b8a-fb58-59cf-ba26-2e1ce5d43ad9
		summarizeBy: none
		sourceColumn: weekday_num

		annotation SummarizationSetBy = User

	column weekday_name
		dataType: string
		lineageTag: 3fd4d1bf-10d2-596d-bb23-10bebf0b90a7
		summarizeBy: none
		sourceColumn: weekday_name
		sortByColumn: weekday_num

		annotation SummarizationSetBy = User

	column is_weekend
		dataType: boolean
		lineageTag: dbd84709-6e67-5a33-9b68-ac87aac6784b
		summarizeBy: none
		sourceColumn: is_weekend

		annotation SummarizationSetBy = User

	/// TRUE for Jan 2015 - Sep 2017 (the report-level default filter)
	column in_analysis_window
		dataType: boolean
		lineageTag: c5ae62fa-9a69-5c0d-a9bd-8e5e938fd0b8
		summarizeBy: none
		sourceColumn: in_analysis_window

		annotation SummarizationSetBy = User

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Selected = Table.SelectColumns(Promoted, {"date_key", "date", "year", "quarter", "month", "month_name", "month_start", "year_month", "weekday_num", "weekday_name", "is_weekend", "in_analysis_window"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"date_key", Int64.Type}, {"date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"month_start", type date}, {"year_month", type text}, {"weekday_num", Int64.Type}, {"weekday_name", type text}, {"is_weekend", type logical}, {"in_analysis_window", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
